# Copy to .env (or export the variables) and adjust.
ANTHROPIC_API_KEY=

# PostgreSQL + pgvector (docker compose up -d)
RAG_DSN=postgresql://rag:rag@localhost:5432/rag

# Embeddings from any OpenAI-compatible server, e.g. LM Studio
RAG_EMBED_BASE_URL=http://localhost:1234/v1
RAG_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
RAG_EMBED_DIM=768
RAG_EMBED_DOC_PREFIX="search_document: "
RAG_EMBED_QUERY_PREFIX="search_query: "

# Agent
RAG_MODEL=claude-opus-5-5
RAG_EFFORT=medium
RAG_TOP_K=5
RAG_MAX_STEPS=4

# Approximate USD per million tokens, used only for the cost estimate. Check the official pricing page.
RAG_PRICE_INPUT=4.0
RAG_PRICE_OUTPUT=20.0
RAG_PRICE_CACHE_WRITE=5.0
RAG_PRICE_CACHE_READ=0.2
